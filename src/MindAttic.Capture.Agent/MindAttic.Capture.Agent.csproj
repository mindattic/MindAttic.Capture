<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>capture</AssemblyName>
    <RootNamespace>MindAttic.Capture.Agent</RootNamespace>
    <!-- AgentLocator only trusts a capture.exe carrying this product name. -->
    <Product>MindAttic.Capture.Agent</Product>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Capture.Windows\MindAttic.Capture.Windows.csproj" />
    <!-- agent.json lives under VaultPaths.LocalApp("Capture"), so MINDATTIC_VAULT_LOCAL_ROOT relocates it. -->
    <PackageReference Include="MindAttic.Vault" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Capture.Windows.Tests" />
  </ItemGroup>

</Project>
